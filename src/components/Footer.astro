---
interface Props {
  isFullPage?: boolean;
}
const { isFullPage = false } = Astro.props;
---

<footer class={`footer ${isFullPage ? "full-page" : ""}`}>
  <div class="footer-container">
    <div class="footer-section identity">
      <h3>Senne De Backer</h3>
      <p class="muted">Buggenhout, Belgium</p>
    </div>

    <div class="footer-section contact">
      <p>
        <strong>E-mail:</strong>
        <a href="mailto:design.debacker@gmail.com">design.debacker@gmail.com</a>
      </p>
    </div>

    <div class="footer-section socials">
      <a
        href="https://github.com/senne-debacker"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
      <a href="https://www.linkedin.com/in/senne-de-backer-3b945642b" target="_blank" rel="noopener noreferrer">LinkedIn</a
      >
      <a
        href="https://www.instagram.com/debacker_devine/"
        target="_blank"
        rel="noopener noreferrer">Instagram</a
      >
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 3rem 1.5rem;
    width: 100%;
    background: #050914;
  }

  .footer.full-page {
    border-top: none;
    background: transparent;
    padding: 0;
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .footer.full-page .footer-container {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.5rem;
  }

  .footer-section h3 {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
  }

  .muted {
    color: var(--text-color);
    font-size: 0.9rem;
  }

  .socials {
    display: flex;
    gap: 1.5rem;
  }

  .footer.full-page .socials {
    justify-content: center;
    flex-wrap: wrap;
  }

  .disabled {
    color: var(--text-muted);
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      gap: 1.5rem;
    }
    .socials {
      flex-wrap: wrap;
    }
  }
</style>
