---
import { Image } from "astro:assets";
import { featured, projects, pad } from "../data/projects";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const p = featured;
const number = pad(projects.indexOf(p) + 1);
const href = `${baseUrl}/work/${p.id}`;
---

<section class="featured wrap" style={`--p-accent: ${p.accent}`} aria-labelledby="featured-title">
  <div class="top label rule">
    <span>Featured project</span>
    <span class="muted">{p.type}</span>
    <span class="muted hide-sm">Scroll ↓</span>
  </div>

  <div class="grid">
    <div class="info">
      <p class="label muted">No.</p>
      <p class="numeral" data-reveal aria-hidden="true">
        {[...number].map((d, i) => <span style={`--d:${i * 0.08}s`}>{d}</span>)}
      </p>

      <h2 id="featured-title" class="title" data-reveal>{p.title}</h2>
      <p class="tagline" data-reveal style="--delay: 0.1s">{p.tagline}</p>

      <dl class="meta">
        <div class="row rule" data-reveal style="--delay: 0.15s">
          <dt class="label muted">Type</dt>
          <dd class="label">{p.type}</dd>
        </div>
        <div class="row rule" data-reveal style="--delay: 0.2s">
          <dt class="label muted">Role</dt>
          <dd class="label">{p.role}</dd>
        </div>
        <div class="row rule" data-reveal style="--delay: 0.25s">
          <dt class="label muted">Context</dt>
          <dd class="label">{p.context}</dd>
        </div>
      </dl>

      <a href={href} class="pill pill--solid cta" data-magnetic="0.25">
        View project <span class="arrow">→</span>
      </a>
    </div>

    <div class="media-wrap" data-parallax="0.05">
    <a
      href={href}
      class="media"
      data-cursor="View"
      aria-label={`View ${p.title} project`}
      style={`aspect-ratio: ${p.image.width} / ${p.image.height}`}
      data-reveal
    >
        <Image
          src={p.image}
          alt=""
          widths={[640, 1024, 1600, 2200]}
          sizes="(max-width: 900px) 100vw, 60vw"
          loading="eager"
        />
      <span class="chips">
        {p.tags.map((t) => <span class="chip label">{t}</span>)}
      </span>
    </a>
    </div>
  </div>
</section>

<style>
  .featured {
    padding-top: clamp(4rem, 10vw, 9rem);
  }

  .top {
    display: flex;
    justify-content: space-between;
    padding-top: 0.6rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: 2.5rem;
  }

  .info {
    display: flex;
    flex-direction: column;
  }

  .numeral {
    display: flex;
    overflow: hidden;
    margin-top: -0.1em;
    font-size: clamp(8rem, 22vw, 22rem);
    font-weight: 300;
    line-height: 0.8;
    letter-spacing: -0.07em;
    color: var(--fg);
    padding-bottom: 0.04em;
  }

  /* Digits roll up into place when revealed. */
  .js .numeral[data-reveal] {
    opacity: 1;
    transform: none;
  }

  .js .numeral span {
    display: inline-block;
    transform: translateY(105%);
    transition: transform 1.2s var(--ease-out) var(--d);
  }

  .js .numeral.is-in span {
    transform: none;
  }

  .title {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: clamp(2.25rem, 4.5vw, 4.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .tagline {
    max-width: 28ch;
    margin-top: 0.75rem;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: var(--muted);
    line-height: 1.35;
  }

  .meta {
    margin-top: 2.5rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1rem;
    padding: 0.55rem 0 1.25rem;
  }

  .cta {
    align-self: flex-start;
    margin-top: auto;
  }

  .media-wrap {
    align-self: start;
  }

  .media {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--surface);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 1.2s var(--ease-out),
      filter 1.2s var(--ease-out);
  }

  .media:hover :global(img) {
    transform: scale(1.04);
  }

  .media::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 0 var(--p-accent);
    transition: box-shadow 0.6s var(--ease-out);
    pointer-events: none;
  }

  .media:hover::after {
    box-shadow: inset 0 0 0 3px var(--p-accent);
  }

  .chips {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chip {
    padding: 0.3em 0.55em;
    border-radius: 3px;
    background: rgba(5, 5, 5, 0.7);
    backdrop-filter: blur(6px);
    font-size: 0.625rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .media-wrap {
      order: -1;
    }

    .cta {
      margin-top: 2rem;
    }

    .hide-sm {
      display: none;
    }
  }
</style>
