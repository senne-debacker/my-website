---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Hide the big "Let's work together" call-to-action in the footer. */
  hideFooterCta?: boolean;
}

const {
  title,
  description = "Senne De Backer, UX/UI designer and creative developer based in Buggenhout, Belgium.",
  hideFooterCta = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} | Senne De Backer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Inter+Tight:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Marks that JS is running so reveal animations may hide content first.
      // ClientRouter copies <html> attributes from the next page, so re-apply after each swap.
      document.documentElement.classList.add("js");
      document.addEventListener("astro:after-swap", () =>
        document.documentElement.classList.add("js"),
      );
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a href="#main" class="skip-link label">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer cta={!hideFooterCta} />
    <Cursor />
  </body>
</html>

<script>
  import "../scripts/interactions";
</script>

<style is:global>
  .skip-link {
    position: fixed;
    top: -4rem;
    left: 0.75rem;
    z-index: 1000;
    padding: 0.5rem 0.75rem;
    background: var(--fg);
    color: var(--bg);
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  /* Page transition: old page drifts up and fades, new page rises in. */
  ::view-transition-old(root) {
    animation: 0.35s cubic-bezier(0.7, 0, 0.84, 0) both page-out;
  }

  ::view-transition-new(root) {
    animation: 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both page-in;
  }

  @keyframes page-out {
    to {
      opacity: 0;
      transform: translateY(-24px);
    }
  }

  @keyframes page-in {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }
</style>
