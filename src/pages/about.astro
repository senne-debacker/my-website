---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import portrait from "../assets/about-me-001.png";
import desk from "../assets/about-me-002.png";
import ski from "../assets/about-me-003-cropped.png";
import selfie from "../assets/tokyo-1.png";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const photos = [
  { src: desk, alt: "Senne drawing at a desk under a lamp", caption: "Sketching", position: "55% 45%" },
  { src: ski, alt: "Senne smiling in a ski lift, wearing a tie", caption: "On the slopes", position: "50% 30%" },
  { src: selfie, alt: "Senne in the classroom", caption: "In class", position: "45% 30%" },
];

const skills = [
  {
    group: "Frontend & Creative Dev",
    items: ["HTML5 / CSS3 / JavaScript (ES6+)", "TypeScript", "React & Astro", "Three.js & WebGPU", "Git & GitHub"],
  },
  {
    group: "Design & Motion",
    items: [
      "UI/UX Design (Figma)",
      "3D Design (Blender)",
      "Adobe Creative Suite (Illustrator, Photoshop)",
      "Motion Design (After Effects)",
    ],
  },
];
---

<Layout title="About">
  <section class="about wrap">
    <p class="label muted">(About)</p>

    <div class="intro">
      <h1 class="headline">
        <span class="line"><span>Designer</span></span>
        <span class="line"><span>&amp; creative</span></span>
        <span class="line"><span>developer</span></span>
      </h1>

      <figure class="portrait" data-reveal>
        <div class="portrait-inner" data-parallax="0.06">
          <Image src={portrait} alt="Senne De Backer" widths={[480, 900]} sizes="(max-width: 800px) 70vw, 28vw" />
        </div>
        <figcaption class="label muted">Senne De Backer, Buggenhout BE</figcaption>
      </figure>
    </div>

    <div class="cols">
      <p class="label muted sticky">(Bio)</p>
      <div class="body">
        <p class="lead" data-reveal>
          Hi, I'm Senne, a 23-year-old Creative Developer and Designer based in Buggenhout. I am currently in
          my third and final year of Digital Design &amp; Development (Devine) at Howest Kortrijk.
        </p>

        <h2 class="label" data-reveal>Leadership &amp; soft skills</h2>
        <p data-reveal>
          Beyond code and screens, I have spent 16 years in the Chiro (youth movement), serving 4 years as a youth
          leader and 3 years as the group leader (groepsleider).
        </p>
        <p data-reveal>
          Leading a group of over 200 kids and adolescents and managing a team of 35 co-leaders taught me skills
          like communication, crisis management, organization, planning, and mainly: <strong>working as a team</strong>.
        </p>

        <h2 class="label" data-reveal>Freelance &amp; collaborations</h2>
        <p data-reveal>
          I am registered as a student-entrepreneur and am currently available for freelance projects, working
          remotely or on-site.
        </p>
      </div>
    </div>

    <ul class="photos">
      {
        photos.map((ph, i) => (
          <li class="photo" data-reveal style={`--delay:${i * 0.08}s`}>
            <figure>
              <div class="photo-frame">
                <Image
                  src={ph.src}
                  alt={ph.alt}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 800px) 80vw, 30vw"
                  style={`object-position:${ph.position}`}
                />
              </div>
              <figcaption class="label muted">{ph.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <section class="skills" aria-labelledby="skills-title">
      <h2 id="skills-title" class="section-head" data-reveal>
        <span>Hard</span>
        <span>Skills</span>
      </h2>
      {
        skills.map((s) => (
          <div class="skill-group">
            <h3 class="label muted" data-reveal>{s.group}</h3>
            <ul>
              {s.items.map((item, i) => (
                <li class="skill rule" data-reveal>
                  <span class="label muted">{String(i + 1).padStart(2, "0")}</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <a href={`${baseUrl}/contact`} class="pill pill--solid cta" data-magnetic="0.25">
      Let's connect <span class="arrow">→</span>
    </a>
  </section>
</Layout>

<style>
  .about {
    padding-top: clamp(3rem, 8vw, 7rem);
  }

  .intro {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
    margin-top: 1rem;
  }

  .headline {
    font-size: clamp(3.5rem, 11vw, 11.5rem);
    font-weight: 400;
    line-height: 0.84;
    letter-spacing: -0.065em;
    text-transform: uppercase;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-right: 0.08em;
    padding-bottom: 0.04em;
  }

  .line > span {
    display: inline-block;
    animation: rise 1.2s var(--ease-out) backwards;
  }

  .line:nth-child(2) {
    padding-left: 1em;
  }

  .line:nth-child(2) > span {
    animation-delay: 0.08s;
  }

  .line:nth-child(3) > span {
    animation-delay: 0.16s;
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  .portrait {
    width: clamp(160px, 22vw, 360px);
  }

  .portrait-inner {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--surface);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease-out);
  }

  .portrait:hover :global(img) {
    filter: none;
  }

  figcaption {
    margin-top: 0.6rem;
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    padding-top: clamp(4rem, 9vw, 8rem);
  }

  .sticky {
    position: sticky;
    top: 5rem;
    align-self: start;
  }

  .body {
    max-width: 42rem;
  }

  .body p {
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
    line-height: 1.55;
    color: #cfccc6;
  }

  .body p + p {
    margin-top: 1em;
  }

  .body .lead {
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--fg);
  }

  .body h2 {
    margin: 3rem 0 1rem;
    font-weight: 400;
  }

  strong {
    color: var(--fg);
    font-weight: 500;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
    list-style: none;
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  /* Stagger the row so it reads like a contact sheet, not a grid. */
  .photo:nth-child(2) {
    margin-top: clamp(2rem, 6vw, 6rem);
  }

  .photo:nth-child(3) {
    margin-top: clamp(1rem, 3vw, 3rem);
  }

  .photo-frame {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--surface);
  }

  .photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition:
      filter 0.8s var(--ease-out),
      transform 1.2s var(--ease-out);
  }

  .photo:hover .photo-frame :global(img) {
    filter: none;
    transform: scale(1.04);
  }

  .skills {
    padding-top: clamp(6rem, 12vw, 11rem);
  }

  .skill-group {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .skill-group ul {
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .skill {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: baseline;
    padding: 0.75rem 0;
    font-size: clamp(1.25rem, 2.2vw, 2rem);
    letter-spacing: -0.03em;
    transition:
      padding-left 0.5s var(--ease-out),
      color 0.3s;
  }

  .skill:hover {
    padding-left: 0.75rem;
    color: var(--accent);
  }

  .cta {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  @media (max-width: 800px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .portrait {
      width: 60vw;
      justify-self: end;
    }

    .cols,
    .skill-group {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .sticky {
      position: static;
    }

    .photos {
      grid-template-columns: 1fr 1fr;
    }

    .photo:nth-child(3) {
      grid-column: 1 / -1;
      width: 60%;
    }
  }
</style>
